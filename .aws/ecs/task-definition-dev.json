{
    "family": "reats-dev-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "3072",
    "executionRoleArn": "arn:aws:iam::189773933338:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::189773933338:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "django_app",
            "essential": true,
            "image": "189773933338.dkr.ecr.eu-central-1.amazonaws.com/reats/django:REPLACED_BY_CI",
            "portMappings": [
                {
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "ENV",
                    "value": "dev"
                },
                {
                    "name": "AWS_PUBLIC_KEY",
                    "value": "reats-dev-public-key"
                },
                {
                    "name": "AWS_PRIVATE_KEY",
                    "value": "reats-dev-private-key"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/reats-dev-task",
                    "awslogs-region": "eu-central-1",
                    "awslogs-stream-prefix": "ecs",
                    "awslogs-create-group": "true",
                    "mode": "non-blocking",
                    "max-buffer-size": "25m"
                }
            }
        }
    ]
}